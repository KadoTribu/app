rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuth() {
      return request.auth != null;
    }
    
    function getEvent(eventId) {
      return get(/databases/$(database)/documents/eventos/$(eventId));
    }

    // Users & Subcollections
    match /users/{userId} {
      allow read: if isAuth();
      allow write: if isAuth() && request.auth.uid == userId;

      // Wishlist: Public read, User write
      match /wishlist/{giftId} {
        allow read: if isAuth();
        allow write: if isAuth() && request.auth.uid == userId;
      }
      
      // Saved Contacts: Private read/write
      match /savedContacts/{contactId} {
        allow read, write: if isAuth() && request.auth.uid == userId;
      }
    }

    // Eventos
    match /eventos/{eventId} {
      allow read: if isAuth() && request.auth.uid in resource.data.participantIds;
      allow create: if isAuth() && request.resource.data.organizerId == request.auth.uid;
      allow update: if isAuth() && request.auth.uid in resource.data.participantIds;
      allow delete: if isAuth() && resource.data.organizerId == request.auth.uid;
    }

    // Regalos
    match /regalos/{giftId} {
       allow read: if isAuth() && 
         request.auth.uid in getEvent(resource.data.eventId).data.participantIds;
         
       // Create/Update: use request.resource.data.eventId
       allow create, update: if isAuth() && 
         request.auth.uid in getEvent(request.resource.data.eventId).data.participantIds;
         
       // Delete: use resource.data.eventId
       allow delete: if isAuth() && 
         request.auth.uid in getEvent(resource.data.eventId).data.participantIds;
    }
    
    // Deudas
    match /deudas/{debtId} {
       // Logic: Users involved in the debt OR participants of the event can see/edit
       // For MVP simplicity and to allow Event Deletion by Organizer:
       allow read: if isAuth();
       allow create: if isAuth();
       allow update: if isAuth();
       allow delete: if isAuth();
    }
  }
}
